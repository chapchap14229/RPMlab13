<Window x:Class="Lab13.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Чудо Обувь — каталог" Height="640" Width="920" WindowStartupLocation="CenterScreen" FontFamily="Calibri" FontSize="14" Background="#FFFFFF">
<DockPanel>
<Border DockPanel.Dock="Top" Background="#D2F6E7" Padding="12,8">
<Grid>
<Grid.ColumnDefinitions>
<ColumnDefinition Width="Auto"/>
<ColumnDefinition Width="*"/>
<ColumnDefinition Width="Auto"/>
</Grid.ColumnDefinitions>
<Image x:Name="LogoImage" Width="56" Height="56" Stretch="Uniform"/>
<TextBlock Grid.Column="1" Text="Чудо Обувь" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="14,0,0,0"/>
<TextBlock x:Name="UserTextBlock" Grid.Column="2" Text="гость" VerticalAlignment="Center" FontSize="14"/>
</Grid>
</Border>
<Border DockPanel.Dock="Top" Padding="12,10">
<StackPanel Orientation="Horizontal">
<TextBlock Text="поиск" VerticalAlignment="Center" Margin="0,0,8,0"/>
<TextBox x:Name="SearchTextBox" Width="220" Height="28"/>
<TextBlock Text="произв" VerticalAlignment="Center" Margin="16,0,8,0"/>
<ComboBox x:Name="ManufacturerComboBox" Width="160" Height="28" SelectedIndex="0">
<ComboBoxItem Content="все"/>
<ComboBoxItem Content="Nike"/>
<ComboBoxItem Content="Ralf"/>
<ComboBoxItem Content="NoName"/>
</ComboBox>
<Button x:Name="BtnSearch" Content="найти" Width="100" Height="30" Margin="16,0,0,0" Background="#70B2AF" Click="BtnSearch_Click"/>
<Button x:Name="BtnDiscounts" Content="скидка" Width="100" Height="30" Margin="8,0,0,0" Click="BtnDiscounts_Click"/>
</StackPanel>
</Border>
<Border DockPanel.Dock="Bottom" Background="#D2F6E7" Padding="12,8">
<TextBlock x:Name="StatusTextBlock" FontWeight="Bold" Text="найдено: 0"/>
</Border>
<ListView x:Name="ProductsListBox" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
<ListView.ItemContainerStyle>
<Style TargetType="ListViewItem">
<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
<Setter Property="Background" Value="#FFFFFF"/>
<Setter Property="Margin" Value="0,0,0,4"/>
<Style.Triggers>
<DataTrigger Binding="{Binding IsLowStock}" Value="True">
<Setter Property="Background" Value="#FF8080"/>
</DataTrigger>
</Style.Triggers>
</Style>
</ListView.ItemContainerStyle>
<ListView.ItemTemplate>
<DataTemplate>
<Grid Margin="8,6">
<Grid.ColumnDefinitions>
<ColumnDefinition Width="110"/>
<ColumnDefinition Width="*"/>
<ColumnDefinition Width="150"/>
</Grid.ColumnDefinitions>
<Image Source="{Binding ImagePath}" Width="100" Height="100" Stretch="Uniform"/>
<StackPanel Grid.Column="1" Margin="12,0">
<TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16"/>
<TextBlock Text="{Binding Category}"/>
<TextBlock Text="{Binding Manufacturer}"/>
<TextBlock Text="{Binding Material}" TextWrapping="Wrap"/>
</StackPanel>
<StackPanel Grid.Column="2">
<TextBlock Text="{Binding PriceText}" FontWeight="Bold" FontSize="16"/>
<TextBlock Text="{Binding QuantityText}"/>
</StackPanel>
</Grid>
</DataTemplate>
</ListView.ItemTemplate>
</ListView>
</DockPanel>
</Window>